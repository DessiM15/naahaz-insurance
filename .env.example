# Canonical site URL. Drives metadata, sitemap, canonical tags and OG URLs.
# Domain decision is deliberately a one-line change — see lib/site.ts.
NEXT_PUBLIC_SITE_URL="https://www.yourhealthinsurance.net"

# --- Leads --------------------------------------------------------------
# Which LeadProvider implementation handles form submissions.
# console | resend | webhook | sheets
LEAD_PROVIDER="console"

# LEAD_TO_EMAIL=""        # TODO(client): confirm the real inbox.
# RESEND_API_KEY=""
# LEAD_WEBHOOK_URL=""

# --- Analytics ----------------------------------------------------------
# GA4 stays off until the client supplies a real measurement ID.
# NEXT_PUBLIC_GA_ID=""

# --- Booking ------------------------------------------------------------
# When the client provides a Calendly/Acuity link, set it here and the native
# booking flow swaps to the embed. Leave empty to use the native flow.
# NEXT_PUBLIC_BOOKING_EMBED_URL=""
